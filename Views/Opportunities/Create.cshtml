@model AcxiomCRM.Models.Opportunity

@{
    ViewData["Title"] = "Add Opportunity";
}

<h1>Add Opportunity</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Customer"></label>
        <input asp-for="Customer" class="form-control" />
        <span asp-validation-for="Customer" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Amount"></label>
        <input asp-for="Amount" type="number" class="form-control" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Probability"></label>
        <input asp-for="Probability" type="number" class="form-control" />
        <span asp-validation-for="Probability" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Stage"></label>
        <select asp-for="Stage" class="form-control">
            <option>Prospecting</option>
            <option>Qualification</option>
            <option>Proposal</option>
            <option>Negotiation</option>
            <option>Closed Won</option>
            <option>Closed Lost</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Status"></label>
        <select asp-for="Status" class="form-control">
            <option>Open</option>
            <option>Won</option>
            <option>Lost</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="ExpectedCloseDate"></label>
        <input asp-for="ExpectedCloseDate"
               type="date"
               class="form-control" />
        <span asp-validation-for="ExpectedCloseDate"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Opportunity</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>

</form>