@model IEnumerable<AcxiomCRM.Models.Lead>

@{
    ViewData["Title"] = "Leads";
}

<h1>Leads</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Lead</a>
</p>

<form asp-action="Index" method="get">
    <div class="input-group mb-3">
        <input type="text"
               name="search"
               class="form-control"
               placeholder="Search name, email, company or status" />

        <button type="submit" class="btn btn-secondary">
            Search
        </button>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Company</th>
            <th>Status</th>
            <th>Assigned To</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var lead in Model)
        {
            <tr>
                <td>@lead.Name</td>
                <td>@lead.Email</td>
                <td>@lead.Company</td>
                <td>@lead.Status</td>
                <td>@lead.AssignedTo</td>
            </tr>
        }
    </tbody>
</table>